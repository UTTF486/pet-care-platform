<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 继承 Spring Boot 父工程，统一管理依赖版本，避免版本冲突 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.7.18</version>
        <relativePath/>
    </parent>

    <groupId>com.petcare</groupId>
    <artifactId>pet-care-server</artifactId>
    <version>1.0.0</version>
    <name>pet-care-server</name>
    <description>智慧宠物服务上门平台 - 后端</description>

    <properties>
        <java.version>1.8</java.version>
        <mybatis.starter.version>2.3.1</mybatis.starter.version>
        <!--
          覆盖 Spring Boot 2.7 默认管理的 Lombok 1.18.30。
          原因：1.18.30 不支持 JDK 24/25，在 IDEA 用高版本 JDK 编译时
          注解处理器会失效（不报明显错误），导致 @Data/@Slf4j 生成的
          getter、log 全部缺失，编译时大面积"找不到符号"。
          1.18.48 同时兼容 JDK 8 ~ 25。
        -->
        <lombok.version>1.18.48</lombok.version>
    </properties>

    <dependencies>
        <!-- Web：SpringMVC + 内嵌 Tomcat -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 参数校验：@NotBlank / @Min 等注解 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- AOP：Redis 接口限流切面靠它 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!-- Redis：登录态存储 + 热点数据缓存 + 限流计数 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- Lettuce 连接池依赖，缺了它 spring.redis.lettuce.pool 配置不生效 -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-pool2</artifactId>
        </dependency>

        <!-- MyBatis（SSM 中的 M），SpringBoot 整合版 -->
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
            <version>${mybatis.starter.version}</version>
        </dependency>

        <!-- MySQL 驱动（8.x 用 com.mysql:mysql-connector-j 坐标） -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>8.0.33</version>
            <scope>runtime</scope>
        </dependency>

        <!-- 只引 crypto 模块即可用 BCryptPasswordEncoder，不必引入整个 Spring Security -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!-- Lombok：@Data 自动生成 getter/setter，代码量减半 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
              显式声明注解处理器路径。
              为什么必须写：JDK 23 起 javac 不再自动从 classpath 发现注解处理器，
              只把 Lombok 当普通 jar，导致 @Data/@Slf4j 全部失效、编译报"找不到符号"。
              声明 annotationProcessorPaths 后 javac 会收到 processor-path 参数，注解处理重新生效。
              这样 JDK 8 / 17 / 25 都能正常编译。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- Lombok 只在编译期生效，打包时排除 -->
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
